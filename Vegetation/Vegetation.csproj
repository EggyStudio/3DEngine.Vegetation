<Project Sdk="Microsoft.NET.Sdk">

    <!-- The library both engines reference from their own projects, which knows no engine
         (N 2.1). -->
    <PropertyGroup>
        <RootNamespace>Vegetation</RootNamespace>
        <!-- The assembly and the package take the family's name, a name and no reference, so the
             library still knows no engine; the namespace stays Vegetation. -->
        <AssemblyName>3DEngine.Vegetation</AssemblyName>
        <PackageId>3DEngine.Vegetation</PackageId>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- Every public member has a summary (STYLE.md), so a missing one stops the build, as a cref
         that names nothing does. -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1574</WarningsAsErrors>
    </PropertyGroup>

    <!-- Materials reads the texture collection's manifest, which TreeTextures takes its sets from.
         A Materials checkout beside this one is taken where it stands, so a program that takes
         both builds one Materials, and this repository's own submodule is the one taken where none
         stands beside it. -->
    <PropertyGroup>
        <MaterialsProject>$(MSBuildThisFileDirectory)..\..\Materials\Materials\Materials.csproj</MaterialsProject>
        <MaterialsProject Condition="!Exists('$(MaterialsProject)')">$(MSBuildThisFileDirectory)..\modules\Materials\Materials\Materials.csproj</MaterialsProject>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="$(MaterialsProject)" />
    </ItemGroup>
    <Target Name="NeedsMaterials" BeforeTargets="Restore;CollectPackageReferences;ResolveProjectReferences" Condition="!Exists('$(MaterialsProject)')">
        <Error Text="No Materials checkout stands beside this one and the Materials submodule is not fetched. Run git submodule update --init modules/Materials." />
    </Target>

    <!-- The tests reach Exact, the module's own arithmetic, to hold it against the runtime's. -->
    <ItemGroup>
        <InternalsVisibleTo Include="3DEngine.Vegetation.Tests" />
    </ItemGroup>

    <!-- The texture collection and its manifest, which TreeTextures reads from the assembly, so an
         engine and a game carry no folder for them. The sets waiting for their source are left out,
         as they are left out of the repository, so a build on a machine that imported them carries
         none of them. -->
    <ItemGroup>
        <EmbeddedResource Include="Textures/textures.json" LogicalName="Vegetation/Textures/textures.json"/>
        <EmbeddedResource Include="Textures/**/*.ktx2" Exclude="Textures/waiting/**"
                          LogicalName="Vegetation/Textures/%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

</Project>
